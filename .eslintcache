 165 |     setIsLoaded(false)\n  166 |     const timer = setTimeout(() => {\n  167 |       setIsLoaded(true)",["2549"],"react-hooks/refs","Error: Cannot access refs during render\n\nReact refs are values that are not needed for rendering. Refs should only be accessed outside of render, such as in event handlers or effects. Accessing a ref value (the `current` property) during render can cause your component not to update as expected (https://react.dev/reference/react/useRef).\n\n/Users/rahulsulegaokar/Documents/Github/rahul-portfolio/src/components/charts/tooltip/chart-tooltip.tsx:144:21\n  142 |   // Use portal to render into the chart container\n  143 |   // Only render after mount on client side\n> 144 |   const container = containerRef.current\n      |                     ^^^^^^^^^^^^^^^^^^^^ Passing a ref to a function may read its value during render\n  145 |   if (!(mounted && container)) {\n  146 |     return null\n  147 |   }",["2550"],"Error: Cannot access refs during render\n\nReact refs are values that are not needed for rendering. Refs should only be accessed outside of render, such as in event handlers or effects. Accessing a ref value (the `current` property) during render can cause your component not to update as expected (https://react.dev/reference/react/useRef).\n\n/Users/rahulsulegaokar/Documents/Github/rahul-portfolio/src/components/charts/tooltip/chart-tooltip.tsx:145:9\n  143 |   // Only render after mount on client side\n  144 |   const container = containerRef.current\n> 145 |   if (!(mounted && container)) {\n      |         ^^^^^^^^^^^^^^^^^^^^ Cannot access ref value during render\n  146 |     return null\n  147 |   }\n  148 |\n\nTo initialize a ref only once, check that the ref is null with the pattern `if (ref.current == null) { ref.current = ... }`",["2551"],"@typescript-eslint/no-require-imports","A `require()` style import is forbidden.","CallExpression","noRequireImports",["2552"],"@typescript-eslint/consistent-type-imports","`impor